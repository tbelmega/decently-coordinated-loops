{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["pass", "summary", "coverage", "obligations", "findings"],
  "properties": {
    "pass": { "enum": ["diff", "integration", "adversarial"] },
    "summary": { "type": "string", "minLength": 1 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "instructionFiles", "callsites"],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "hunks"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "hunks": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "instructionFiles": { "type": "array", "items": { "type": "string" } },
        "callsites": { "type": "array", "items": { "type": "string" } }
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "status", "evidence"],
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["fixed", "incomplete", "regressed"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "title", "file", "line", "evidence", "impact", "direction", "confidence", "origin"],
        "properties": {
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "title": { "type": "string", "minLength": 1 },
          "file": { "type": ["string", "null"], "minLength": 1 },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "direction": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["high", "medium", "low"] },
          "origin": { "enum": ["original", "remediation", "base-delta", "unknown"] },
          "obligationId": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    }
  }
}
